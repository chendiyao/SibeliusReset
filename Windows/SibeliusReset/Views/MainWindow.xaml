<Window x:Class="SibeliusReset.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SibeliusReset.Views"
        xmlns:vm="clr-namespace:SibeliusReset.ViewModels"
        xmlns:converters="clr-namespace:SibeliusReset.Converters"
        Title="Sibelius 重置"
        Width="420" Height="520"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:StatusToColorConverter x:Key="StatusToColor"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="ContentPanel"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.6">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="MainBorder"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.5">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="ContentScale"
                                     Storyboard.TargetProperty="ScaleX"
                                     From="0.92" To="1" Duration="0:0:0.6">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="ContentScale"
                                     Storyboard.TargetProperty="ScaleY"
                                     From="0.92" To="1" Duration="0:0:0.6">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid>
        <!-- Main content -->
        <Border x:Name="MainBorder" CornerRadius="28" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="#38E8FF" BlurRadius="40" ShadowDepth="0" Opacity="0.15"/>
            </Border.Effect>
            <Grid>
                <!-- Background gradient -->
                <Border CornerRadius="28">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#050A18" Offset="0"/>
                            <GradientStop Color="#08111F" Offset="0.5"/>
                            <GradientStop Color="#101A33" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Subtle accent glow at top -->
                <Border CornerRadius="28" Height="200" VerticalAlignment="Top" Opacity="0.08">
                    <Border.Background>
                        <RadialGradientBrush Center="0.5,0" GradientOrigin="0.5,0" RadiusX="0.8" RadiusY="1">
                            <GradientStop Color="#38E8FF" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Content layer -->
                <Grid Margin="0">
                    <!-- Title bar -->
                    <Grid Height="48" VerticalAlignment="Top" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Drag area -->
                        <Border Grid.ColumnSpan="2" Background="Transparent"
                                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"/>

                        <!-- Window buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="0,0,16,0">
                            <!-- Help button -->
                            <Button x:Name="HelpButton" Click="HelpButton_Click"
                                    Width="28" Height="28" Margin="0,0,6,0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid>
                                            <Ellipse Width="28" Height="28"
                                                     Fill="#15FFFFFF" Stroke="#20FFFFFF" StrokeThickness="0.5"/>
                                            <TextBlock Text="?" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="#6F7EA3"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Margin="0,-1,0,0"/>
                                        </Grid>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <!-- Minimize button -->
                            <Button Click="MinimizeButton_Click"
                                    Width="28" Height="28" Margin="0,0,6,0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid>
                                            <Ellipse Width="28" Height="28"
                                                     Fill="#15FFFFFF" Stroke="#20FFFFFF" StrokeThickness="0.5"/>
                                            <TextBlock Text="─" FontSize="10" Foreground="#6F7EA3"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Margin="0,-2,0,0"/>
                                        </Grid>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <!-- Close button -->
                            <Button Click="CloseButton_Click"
                                    Width="28" Height="28" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid>
                                            <Ellipse Width="28" Height="28"
                                                     Fill="#20FF4D4D" Stroke="#30FF4D4D" StrokeThickness="0.5"/>
                                            <TextBlock Text="✕" FontSize="11" Foreground="#A9B6D3"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Margin="0,-1,0,0"/>
                                        </Grid>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Main content stack -->
                    <StackPanel x:Name="ContentPanel"
                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                Margin="0,-10,0,0">
                        <StackPanel.RenderTransform>
                            <ScaleTransform x:Name="ContentScale" ScaleX="1" ScaleY="1"
                                            CenterX="210" CenterY="230"/>
                        </StackPanel.RenderTransform>

                        <!-- Title -->
                        <TextBlock Text="Sibelius 试用重置" FontSize="18" FontWeight="Bold"
                                   Foreground="#F4F7FF" HorizontalAlignment="Center"
                                   Margin="0,0,0,16">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#38E8FF" BlurRadius="12"
                                                  ShadowDepth="0" Opacity="0.3"/>
                            </TextBlock.Effect>
                        </TextBlock>

                        <!-- HUD Circle -->
                        <views:HUDCircleControl HorizontalAlignment="Center" Margin="0,0,0,20"/>

                        <!-- Glass Button -->
                        <views:GlassButton
                            ButtonTitle="{Binding ButtonTitle}"
                            ButtonCommand="{Binding ResetCommand}"
                            Status="{Binding Status}"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,16"/>

                        <!-- Info Panel -->
                        <views:InfoPanel
                            LastResetDate="{Binding LastResetDateString}"
                            NextExpireDate="{Binding NextExpireDateString}"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Help Overlay -->
        <views:HelpOverlay x:Name="HelpOverlayControl"
                           Visibility="Collapsed"
                           Closed="HelpOverlay_Closed"/>
    </Grid>
</Window>
