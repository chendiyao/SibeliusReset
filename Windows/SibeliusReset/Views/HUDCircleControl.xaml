<UserControl x:Class="SibeliusReset.Views.HUDCircleControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SibeliusReset.Controls"
             Width="248" Height="248">

    <UserControl.Resources>
        <Storyboard x:Key="SpinStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="SpinRotation1"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="SpinRotation2"
                             Storyboard.TargetProperty="Angle"
                             From="180" To="540" Duration="0:0:2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <Grid Width="248" Height="248">
        <!-- Orbit guide: outer dashed ring -->
        <Ellipse Width="248" Height="248"
                 Stroke="#15FFFFFF" StrokeThickness="1"
                 StrokeDashArray="3 6" Fill="Transparent"/>

        <!-- Orbit guide: middle thin ring -->
        <Ellipse Width="210" Height="210"
                 Stroke="#10FFFFFF" StrokeThickness="0.5"
                 Fill="Transparent"
                 HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- Track ring -->
        <Ellipse Width="210" Height="210"
                 Stroke="#12FFFFFF" StrokeThickness="5"
                 Fill="Transparent"
                 HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- Progress glow (behind main arc) -->
        <controls:ArcShape x:Name="ProgressGlow"
                           Width="210" Height="210"
                           StrokeThickness="8"
                           Stroke="#3038E8FF"
                           StartAngle="-90" EndAngle="-90"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
            <controls:ArcShape.Effect>
                <BlurEffect Radius="12"/>
            </controls:ArcShape.Effect>
        </controls:ArcShape>

        <!-- Progress ring arc -->
        <controls:ArcShape x:Name="ProgressArc"
                           Width="210" Height="210"
                           StrokeThickness="4"
                           StartAngle="-90" EndAngle="-90"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
            <controls:ArcShape.Stroke>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#38E8FF" Offset="0"/>
                    <GradientStop Color="#297BFF" Offset="0.5"/>
                    <GradientStop Color="#7B61FF" Offset="1"/>
                </LinearGradientBrush>
            </controls:ArcShape.Stroke>
        </controls:ArcShape>

        <!-- Trailing node -->
        <Ellipse x:Name="TrailingNode" Width="10" Height="10"
                 Visibility="Collapsed"
                 RenderTransformOrigin="0.5,0.5"
                 HorizontalAlignment="Left" VerticalAlignment="Top">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#38E8FF" Offset="0"/>
                    <GradientStop Color="#1538E8FF" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect>
                <DropShadowEffect Color="#38E8FF" BlurRadius="8" ShadowDepth="0" Opacity="0.6"/>
            </Ellipse.Effect>
            <Ellipse.RenderTransform>
                <TranslateTransform x:Name="NodeTranslate" X="0" Y="0"/>
            </Ellipse.RenderTransform>
        </Ellipse>

        <!-- Inner core circle -->
        <Ellipse Width="162" Height="162"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 Stroke="#18FFFFFF" StrokeThickness="0.5">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#101A33" Offset="0"/>
                    <GradientStop Color="#0A1225" Offset="0.7"/>
                    <GradientStop Color="#050A18" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Center text -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="StatusLabel"
                       Text="{Binding StatusText}"
                       FontSize="11" Foreground="#6F7EA3"
                       HorizontalAlignment="Center" Margin="0,0,0,2"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock x:Name="DaysNumber"
                           Text="{Binding RemainingDaysString}"
                           FontSize="42" FontWeight="Bold" Foreground="#F4F7FF"
                           VerticalAlignment="Bottom">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#38E8FF" BlurRadius="16"
                                          ShadowDepth="0" Opacity="0.4"/>
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="天" FontSize="14" Foreground="#6F7EA3"
                           VerticalAlignment="Bottom" Margin="4,0,0,8"/>
            </StackPanel>
        </StackPanel>

        <!-- Resetting overlay (spinning arcs) -->
        <Canvas x:Name="ResettingOverlay" Width="248" Height="248"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Visibility="Collapsed">
            <controls:ArcShape x:Name="SpinArc1"
                               Width="200" Height="200"
                               StrokeThickness="2" Stroke="#5038E8FF"
                               StartAngle="0" EndAngle="90"
                               Canvas.Left="24" Canvas.Top="24"
                               RenderTransformOrigin="0.5,0.5">
                <controls:ArcShape.RenderTransform>
                    <RotateTransform x:Name="SpinRotation1" Angle="0"/>
                </controls:ArcShape.RenderTransform>
            </controls:ArcShape>
            <controls:ArcShape x:Name="SpinArc2"
                               Width="200" Height="200"
                               StrokeThickness="2" Stroke="#50FF4DFF"
                               StartAngle="180" EndAngle="270"
                               Canvas.Left="24" Canvas.Top="24"
                               RenderTransformOrigin="0.5,0.5">
                <controls:ArcShape.RenderTransform>
                    <RotateTransform x:Name="SpinRotation2" Angle="180"/>
                </controls:ArcShape.RenderTransform>
            </controls:ArcShape>
        </Canvas>

        <!-- Particle dots -->
        <Ellipse Width="3" Height="3" Fill="#2038E8FF"
                 HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="200,30,0,0"/>
        <Ellipse Width="3" Height="3" Fill="#2038E8FF"
                 HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="235,120,0,0"/>
        <Ellipse Width="3" Height="3" Fill="#2038E8FF"
                 HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="40,210,0,0"/>
        <Ellipse Width="3" Height="3" Fill="#2038E8FF"
                 HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="10,100,0,0"/>
    </Grid>
</UserControl>
