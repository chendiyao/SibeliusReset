<UserControl x:Class="SibeliusReset.Views.GlassButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="300">

    <UserControl.Resources>
        <Storyboard x:Key="SweepAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="SweepTranslate"
                             Storyboard.TargetProperty="X"
                             From="0" To="380" Duration="0:0:1.5">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <Button x:Name="MainButton"
            Command="{Binding ButtonCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
            Cursor="Hand">
        <Button.RenderTransform>
            <ScaleTransform x:Name="ButtonScale" ScaleX="1" ScaleY="1"
                            CenterX="150" CenterY="28"/>
        </Button.RenderTransform>
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Grid>
                    <!-- Main border -->
                    <Border x:Name="ButtonBorder" Width="300" Height="56" CornerRadius="32">
                        <Border.Effect>
                            <DropShadowEffect Color="#38E8FF" BlurRadius="20"
                                              ShadowDepth="0" Opacity="0.2"/>
                        </Border.Effect>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#20297BFF" Offset="0"/>
                                <GradientStop Color="#1838E8FF" Offset="0.5"/>
                                <GradientStop Color="#20297BFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>

                        <!-- Inner border with gradient stroke -->
                        <Border CornerRadius="32" BorderThickness="1.5">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#6038E8FF" Offset="0"/>
                                    <GradientStop Color="#40297BFF" Offset="0.5"/>
                                    <GradientStop Color="#607B61FF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>

                            <Grid>
                                <!-- Content: icon + title -->
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="ButtonIcon" Text="⟳" FontSize="20"
                                               Foreground="#38E8FF" VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                                    <TextBlock x:Name="ButtonText"
                                               Text="{Binding ButtonTitle, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               FontSize="16" FontWeight="SemiBold"
                                               Foreground="#F4F7FF" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Loading sweep bar -->
                                <Border x:Name="SweepContainer" CornerRadius="32"
                                        ClipToBounds="True" Visibility="Collapsed">
                                    <Rectangle x:Name="SweepBar" Width="80" Height="56"
                                               Margin="-80,0,0,0" HorizontalAlignment="Left">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="Transparent" Offset="0"/>
                                                <GradientStop Color="#3038E8FF" Offset="0.5"/>
                                                <GradientStop Color="Transparent" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                        <Rectangle.RenderTransform>
                                            <TranslateTransform x:Name="SweepTranslate" X="0"/>
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                </Border>
                            </Grid>
                        </Border>
                    </Border>
                </Grid>

                <!-- Hover / Press triggers -->
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                     Storyboard.TargetProperty="ScaleX"
                                                     To="1.04" Duration="0:0:0.2">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                     Storyboard.TargetProperty="ScaleY"
                                                     To="1.04" Duration="0:0:0.2">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                     Storyboard.TargetProperty="ScaleX"
                                                     To="1.0" Duration="0:0:0.2">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                     Storyboard.TargetProperty="ScaleY"
                                                     To="1.0" Duration="0:0:0.2">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                     Storyboard.TargetProperty="ScaleX"
                                                     To="0.97" Duration="0:0:0.1"/>
                                    <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                     Storyboard.TargetProperty="ScaleY"
                                                     To="0.97" Duration="0:0:0.1"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                     Storyboard.TargetProperty="ScaleX"
                                                     To="1.0" Duration="0:0:0.1"/>
                                    <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                     Storyboard.TargetProperty="ScaleY"
                                                     To="1.0" Duration="0:0:0.1"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Button.Template>
    </Button>
</UserControl>
