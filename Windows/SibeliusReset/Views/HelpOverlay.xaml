<UserControl x:Class="SibeliusReset.Views.HelpOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <!-- Semi-transparent background -->
        <Border Background="#CC000000" MouseLeftButtonDown="Background_Click"/>

        <!-- Centered card -->
        <Border Width="348" MaxHeight="460" CornerRadius="22"
                VerticalAlignment="Center" HorizontalAlignment="Center"
                ClipToBounds="True" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#38E8FF" BlurRadius="30" ShadowDepth="0" Opacity="0.15"/>
            </Border.Effect>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#08111F" Offset="0"/>
                    <GradientStop Color="#0D1628" Offset="0.5"/>
                    <GradientStop Color="#101A33" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#3038E8FF" Offset="0"/>
                    <GradientStop Color="#20297BFF" Offset="0.5"/>
                    <GradientStop Color="#307B61FF" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>

            <Grid Margin="24,20,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="使用方法" FontSize="20" FontWeight="Bold" Foreground="#F4F7FF">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#38E8FF" BlurRadius="12"
                                                  ShadowDepth="0" Opacity="0.3"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="快速了解如何重置 Sibelius 试用期"
                                   FontSize="11" Foreground="#6F7EA3" Margin="0,4,0,0"/>
                    </StackPanel>
                    <!-- X close button -->
                    <Button Click="CloseButton_Click" HorizontalAlignment="Right"
                            VerticalAlignment="Top" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Ellipse Width="28" Height="28"
                                             Fill="#15FFFFFF" Stroke="#20FFFFFF" StrokeThickness="0.5"/>
                                    <TextBlock Text="✕" FontSize="12" Foreground="#6F7EA3"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="0,-1,0,0"/>
                                </Grid>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Steps -->
                <StackPanel Grid.Row="1" Margin="0,0,0,16">
                    <!-- Step 1 -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" CornerRadius="16" HorizontalAlignment="Left">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#2038E8FF" Offset="0"/>
                                    <GradientStop Color="#10297BFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="01" FontSize="12" FontWeight="Bold"
                                       Foreground="#38E8FF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="关闭 Sibelius" FontSize="13" FontWeight="SemiBold"
                                       Foreground="#F4F7FF"/>
                            <TextBlock Text="确保 Sibelius 及相关进程已完全退出"
                                       FontSize="11" Foreground="#6F7EA3"
                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Step 2 -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" CornerRadius="16" HorizontalAlignment="Left">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#2038E8FF" Offset="0"/>
                                    <GradientStop Color="#10297BFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="02" FontSize="12" FontWeight="Bold"
                                       Foreground="#38E8FF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="点击重置按钮" FontSize="13" FontWeight="SemiBold"
                                       Foreground="#F4F7FF"/>
                            <TextBlock Text="自动清除试用计时数据并重置授权"
                                       FontSize="11" Foreground="#6F7EA3"
                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Step 3 -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" CornerRadius="16" HorizontalAlignment="Left">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#2038E8FF" Offset="0"/>
                                    <GradientStop Color="#10297BFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="03" FontSize="12" FontWeight="Bold"
                                       Foreground="#38E8FF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="等待完成" FontSize="13" FontWeight="SemiBold"
                                       Foreground="#F4F7FF"/>
                            <TextBlock Text="重置过程通常只需要几秒钟"
                                       FontSize="11" Foreground="#6F7EA3"
                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Step 4 -->
                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" CornerRadius="16" HorizontalAlignment="Left">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#2038E8FF" Offset="0"/>
                                    <GradientStop Color="#10297BFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="04" FontSize="12" FontWeight="Bold"
                                       Foreground="#38E8FF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="重新启动 Sibelius" FontSize="13" FontWeight="SemiBold"
                                       Foreground="#F4F7FF"/>
                            <TextBlock Text="打开 Sibelius 即可继续使用"
                                       FontSize="11" Foreground="#6F7EA3"
                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Contact info -->
                <Border Grid.Row="2" CornerRadius="12" Padding="14,10" Margin="0,0,0,14">
                    <Border.Background>
                        <SolidColorBrush Color="#0AFFFFFF"/>
                    </Border.Background>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="💬" FontSize="12" Margin="0,0,6,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="微信:" FontSize="11" Foreground="#6F7EA3"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="audioba" FontSize="11" Foreground="#38E8FF"
                                       FontWeight="Medium" Margin="4,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌐" FontSize="12" Margin="0,0,6,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="网站:" FontSize="11" Foreground="#6F7EA3"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="audioba.com" FontSize="11" Foreground="#38E8FF"
                                       FontWeight="Medium" Margin="4,0,0,0"
                                       VerticalAlignment="Center"
                                       Cursor="Hand" MouseLeftButtonDown="Website_Click">
                                <TextBlock.TextDecorations>
                                    <TextDecoration Location="Underline">
                                        <TextDecoration.Pen>
                                            <Pen Brush="#5038E8FF"/>
                                        </TextDecoration.Pen>
                                    </TextDecoration>
                                </TextBlock.TextDecorations>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Back button -->
                <Button Grid.Row="3" Click="BackButton_Click" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Height="44" CornerRadius="22">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#38E8FF" Offset="0"/>
                                        <GradientStop Color="#297BFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="返回" FontSize="14" FontWeight="SemiBold"
                                           Foreground="#050A18"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
